# Production public origin. For local development use http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://girok-fairy-v2.vercel.app

# Keep the existing Supabase project URL and keys; this is NOT the app domain.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
ADMIN_ID=
ADMIN_PASSWORD=
CRON_SECRET=

# Optional: decoded service key for KASI holiday information at data.go.kr/15012690.
# Without this setting (or on lookup failure), general/weekend greetings still work.
KOREAN_HOLIDAY_API_KEY=
